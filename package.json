{
  "name": "tabby-tailscale",
  "version": "0.2.3",
  "description": "Tabby Tailscale - lists Tailscale peers as SSH connection profiles in Tabby, grouped and filtered by regex rules on hostname/tags/online status, with configurable name labels",
  "keywords": [
    "tabby-plugin",
    "tailscale",
    "ssh"
  ],
  "author": "Maximilian Botschen @ enamentis GmbH <maximilian.botschen@enamentis.de>",
  "license": "MIT",
  "main": "dist/index.js",
  "files": [
    "dist"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/enamentis/tabby-tailscale.git"
  },
  "bugs": {
    "url": "https://github.com/enamentis/tabby-tailscale/issues"
  },
  "homepage": "https://github.com/enamentis/tabby-tailscale#readme",
  "scripts": {
    "build": "webpack",
    "prepublishOnly": "npm run build"
  },
  "devDependencies": {
    "typescript": "^5.0.0",
    "webpack": "^5.0.0",
    "webpack-cli": "^5.0.0",
    "ts-loader": "^9.0.0",
    "@angular/core": "9.1.13",
    "tabby-core": "1.0.163",
    "tabby-ssh": "1.0.163",
    "tabby-settings": "1.0.163",
    "tabby-terminal": "1.0.163"
  },
  "peerDependencies": {
    "tabby-core": "*",
    "tabby-settings": "*"
  }
}
